# ==========================================
# HKM CRM & Event Operations Platform
# Environment Variables Configuration
# ==========================================

# 1. Supabase Core Configuration (REQUIRED)
# Find these in your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 2. Supabase Admin & Server Operations (REQUIRED for Admin API & Migration Scripts)
# MUST BE KEPT SECRET. Never expose this key to the browser or public clients.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 3. Operator Authentication (RECOMMENDED)
# Secret key for signing Operator Portal JWT authentication cookies/tokens.
OPERATOR_JWT_SECRET=your_custom_jwt_secret_key_change_in_production

# 4. Application Public URL (OPTIONAL)
# Base domain used for QR codes, callback links, and external redirects.
# Default: Falls back to window.location.origin in browser if omitted.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 5. WhatsApp Community Integration (OPTIONAL)
# Link to WhatsApp community group displayed on festival registration success pages.
NEXT_PUBLIC_KRISHNASHTAMI_WHATSAPP_URL=https://chat.whatsapp.com/your_group_invite_code

# 6. Address Geocoding / Autocomplete (OPTIONAL)
# API key for Geoapify address suggestions in registration forms.
GEOAPIFY_API_KEY=your_geoapify_api_key_here
